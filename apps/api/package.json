{
  "name": "@ihealth/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "cross-env DATABASE_URL=file:./dev.db tsx watch src/index.ts",
    "build": "prisma generate && tsc",
    "start": "cross-env DATABASE_URL=file:./dev.db node dist/index.js",
    "lint": "tsc --noEmit",
    "test": "echo \"No tests yet\"",
    "prepare": "cross-env DATABASE_URL=file:./dev.db prisma generate",
    "db:migrate": "cross-env DATABASE_URL=file:./dev.db prisma migrate deploy",
    "db:generate": "cross-env DATABASE_URL=file:./dev.db prisma generate",
    "db:seed": "cross-env DATABASE_URL=file:./dev.db tsx prisma/seed.ts"
  },
  "prisma": {
    "seed": "cross-env DATABASE_URL=file:./dev.db tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.3.0",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "jose": "^5.10.0",
    "multer": "^1.4.5-lts.1",
    "pdf-parse": "^1.1.1",
    "tesseract.js": "^5.1.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.10.5",
    "cross-env": "^7.0.3",
    "prisma": "^6.3.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
