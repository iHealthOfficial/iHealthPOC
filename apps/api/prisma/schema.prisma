// SQLite for zero-cost local POC; map tables to FHIR resource types in app layer.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

/// FHIR: Patient
model Patient {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  active    Boolean  @default(true)

  family     String?
  given      String   // JSON array of given names, e.g. ["Jane","Q"]
  gender     String? // administrative gender code
  birthDate  DateTime?

  phone      String?
  email      String?
  addressLine String?
  city       String?
  state      String?
  postalCode String?
  country    String? @default("US")

  identifierSystem String?
  identifierValue  String?

  observations Observation[]
  conditions   Condition[]
  uploads      UploadArtifact[]

  practitioners              Practitioner[]
  diagnosticReports        DiagnosticReport[]
  procedures                 Procedure[]
  allergyIntolerances      AllergyIntolerance[]
  encounters               Encounter[]
  coverages                Coverage[]
  medicationRequests       MedicationRequest[]
  medicationAdministrations MedicationAdministration[]
  medicationDispenses      MedicationDispense[]
  medicationStatements     MedicationStatement[]
  medications              Medication[]
  immunizations            Immunization[]
  organizations            Organization[]
  familyMemberHistories    FamilyMemberHistory[]
  linkedUsers                User[]
  activityEvents             ActivityEvent[]
}

/// FHIR: FamilyMemberHistory — subject is always the related Patient (this record)
model FamilyMemberHistory {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  patientId String
  patient   Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)

  identifierSystem String?
  identifierValue  String?
  /// partial | completed | entered-in-error | health-unknown
  status           String?
  dataAbsentReasonText String?
  dataAbsentReasonCode String?
  date             DateTime?
  name             String?
  relationshipText String?
  relationshipCode String?
  sex              String?
  ageString        String?
  deceasedBoolean  Boolean?
  deceasedDate     DateTime?
  reasonText       String?
  reasonCode       String?

  conditions FamilyMemberHistoryCondition[]
  procedures FamilyMemberHistoryProcedure[]
}

/// FamilyMemberHistory.condition — code, outcome, contributedToDeath
model FamilyMemberHistoryCondition {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  familyMemberHistoryId String
  familyMemberHistory   FamilyMemberHistory @relation(fields: [familyMemberHistoryId], references: [id], onDelete: Cascade)

  code               String
  outcomeText        String?
  outcomeCode        String?
  contributedToDeath   Boolean?
}

/// FamilyMemberHistory.procedure — code, outcome, contributedToDeath
model FamilyMemberHistoryProcedure {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  familyMemberHistoryId String
  familyMemberHistory   FamilyMemberHistory @relation(fields: [familyMemberHistoryId], references: [id], onDelete: Cascade)

  code               String
  outcomeText        String?
  outcomeCode        String?
  contributedToDeath   Boolean?
}

/// FHIR: Organization (patient-scoped for manual entry / export in this POC)
model Organization {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  patientId String
  patient   Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)

  identifierSystem String?
  identifierValue  String?
  active           Boolean  @default(true)
  /// CodeableConcept — display / text (e.g. prov, dept, team)
  typeText         String?
  typeCode         String?
  /// Organization.name (FHIR); empty when row not yet filled
  name             String   @default("")
  description      String?

  /// Contact: telecom + optional address line (maps to FHIR Organization.contact / telecom)
  contactPhone       String?
  contactEmail       String?
  contactAddressLine String?

  encountersAsServiceProvider Encounter[] @relation("EncounterServiceProviderOrganization")
}

/// FHIR: Practitioner (captured in context of this patient for export)
model Practitioner {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  patientId String
  patient   Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)

  family     String?
  given      String // JSON array
  phone      String?
  email      String?
  identifierSystem String?
  identifierValue  String?
  specialty        String?

  /// Optional encounter context (separate from Encounter.practitioner participant link)
  contextEncounterId String?
  contextEncounter   Encounter? @relation("PractitionerContextEncounter", fields: [contextEncounterId], references: [id], onDelete: SetNull)

  encountersWhereParticipant Encounter[] @relation("EncounterParticipantPractitioner")
}

/// FHIR: DiagnosticReport (report-level metadata; lab values remain Observation laboratory)
model DiagnosticReport {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  patientId String
  patient   Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)

  encounterId String?
  encounter   Encounter? @relation(fields: [encounterId], references: [id], onDelete: SetNull)

  status              String   @default("final")
  code                String
  conclusion          String?
  effectiveDateTime   DateTime?
  issued              DateTime?
}

/// FHIR: Procedure
model Procedure {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  patientId String
  patient   Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)

  encounterId String?
  encounter   Encounter? @relation(fields: [encounterId], references: [id], onDelete: SetNull)

  status              String?
  code                String
  performedDateTime   DateTime?
  bodySite            String?
}

/// FHIR: AllergyIntolerance
model AllergyIntolerance {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  patientId String
  patient   Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)

  encounterId String?
  encounter   Encounter? @relation(fields: [encounterId], references: [id], onDelete: SetNull)

  clinicalStatus      String?
  verificationStatus  String?
  type                String?
  category            String?
  code                String
  reaction            String?
  onsetDateTime       DateTime?
}

/// FHIR: Encounter
model Encounter {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  patientId String
  patient   Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)

  practitionerId String?
  practitioner   Practitioner? @relation("EncounterParticipantPractitioner", fields: [practitionerId], references: [id], onDelete: SetNull)

  status      String?
  classCode   String?
  typeText    String?
  periodStart DateTime?
  periodEnd   DateTime?

  /// External / legacy business identifier from the source system (manual entry; not the internal UUID).
  legacyIdentifierSystem String?
  legacyIdentifierValue  String?

  /// FHIR Encounter.serviceProvider → Organization
  serviceProviderOrganizationId String?
  serviceProviderOrganization     Organization? @relation("EncounterServiceProviderOrganization", fields: [serviceProviderOrganizationId], references: [id], onDelete: SetNull)

  practitionersWithContext Practitioner[] @relation("PractitionerContextEncounter")
  observations             Observation[]
  conditions               Condition[]
  diagnosticReports        DiagnosticReport[]
  procedures               Procedure[]
  allergyIntolerances      AllergyIntolerance[]
  medicationRequests       MedicationRequest[]
  medicationAdministrations MedicationAdministration[]
  medicationDispenses      MedicationDispense[]
  medicationStatements     MedicationStatement[]
  medications              Medication[]
  immunizations            Immunization[]
}

/// FHIR: Coverage (manual “Insurance” entry; aligns to coverage use-case vs InsurancePlan)
model Coverage {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  patientId String
  patient   Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)

  status            String?
  insurerName       String?
  planName          String?
  subscriberId      String?
  memberId          String?
  relationshipText  String?
  periodStart       DateTime?
  periodEnd         DateTime?
}

/// FHIR: MedicationRequest
model MedicationRequest {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  patientId String
  patient   Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)

  encounterId String?
  encounter   Encounter? @relation(fields: [encounterId], references: [id], onDelete: SetNull)

  status         String?
  intent         String?
  medicationCode String
  dosageText     String?
  authoredOn     DateTime?
  requesterText  String?
}

/// FHIR: MedicationAdministration
model MedicationAdministration {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  patientId String
  patient   Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)

  encounterId String?
  encounter   Encounter? @relation(fields: [encounterId], references: [id], onDelete: SetNull)

  status              String?
  medicationCode      String
  effectiveDateTime   DateTime?
  doseText            String?
  routeText           String?
}

/// FHIR: MedicationDispense
model MedicationDispense {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  patientId String
  patient   Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)

  encounterId String?
  encounter   Encounter? @relation(fields: [encounterId], references: [id], onDelete: SetNull)

  status           String?
  medicationCode   String
  whenHandedOver   DateTime?
  quantityText     String?
  daysSupply       Int?
}

/// FHIR: MedicationStatement
model MedicationStatement {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  patientId String
  patient   Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)

  encounterId String?
  encounter   Encounter? @relation(fields: [encounterId], references: [id], onDelete: SetNull)

  status           String?
  medicationCode   String
  effectiveDateTime DateTime?
  dosageText       String?
}

/// FHIR: Medication (product / catalog-style row for this patient context)
model Medication {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  patientId String
  patient   Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)

  encounterId String?
  encounter   Encounter? @relation(fields: [encounterId], references: [id], onDelete: SetNull)

  code     String
  status   String?
  form     String?
  strength String?
}

/// FHIR: Immunization
model Immunization {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  patientId String
  patient   Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)

  encounterId String?
  encounter   Encounter? @relation(fields: [encounterId], references: [id], onDelete: SetNull)

  status               String?
  vaccineCode          String
  occurrenceDateTime   DateTime?
  lotNumber            String?
  manufacturerText     String?
}

/// FHIR: Observation — use `category` = "laboratory" for labs, else vital-signs, exam, etc.
model Observation {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  patientId String
  patient   Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)

  encounterId String?
  encounter   Encounter? @relation(fields: [encounterId], references: [id], onDelete: SetNull)

  /// laboratory | vital-signs | exam | survey | procedure | other
  category  String
  /// Display or code text (LOINC/SNOMED in real use)
  code      String
  valueString       String?
  valueQuantity     Float?
  valueQuantityUnit String?
  effectiveDateTime DateTime?
  status            String  @default("final")
}

/// FHIR: Condition (diagnosis)
model Condition {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  patientId String
  patient   Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)

  encounterId String?
  encounter   Encounter? @relation(fields: [encounterId], references: [id], onDelete: SetNull)

  clinicalStatus      String? // active | recurrence | inactive | remission | resolved
  verificationStatus  String? // unconfirmed | provisional | differential | confirmed
  code                String  // ICD-10 / SNOMED display or code
  onsetDateTime       DateTime?
  recordedDate        DateTime?
}

/// Uploaded files linked optionally to a patient (Binary / DocumentReference could map here later)
model UploadArtifact {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())

  patientId String?
  patient   Patient? @relation(fields: [patientId], references: [id], onDelete: SetNull)

  originalName String
  mimeType     String
  storagePath  String
  sizeBytes    Int

  /// pending | clean | infected | skipped | error
  scanStatus  String  @default("pending")
  scanMessage String?

  /// pending | done | skipped | error
  ocrStatus  String  @default("pending")
  ocrMessage String?
  ocrText    String?
}

/// Application login (not a FHIR resource)
model User {
  id           String   @id @default(uuid())
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  email        String   @unique
  passwordHash String
  displayName  String?
  /// user | admin
  role         String   @default("user")

  /// Optional FHIR Patient this account may view as “my health data”
  linkedPatientId String?
  linkedPatient   Patient? @relation(fields: [linkedPatientId], references: [id], onDelete: SetNull)

  /// JSON map of resource type → permitted (synced from Consent portal when logged in)
  consentScopesJson String?

  activityEvents ActivityEvent[]
}

/// Audit trail / patient journey (chunk 8)
model ActivityEvent {
  id          String   @id @default(uuid())
  createdAt   DateTime @default(now())
  actorUserId String?
  actorUser   User?    @relation(fields: [actorUserId], references: [id], onDelete: SetNull)
  patientId   String?
  patient     Patient? @relation(fields: [patientId], references: [id], onDelete: Cascade)
  action      String
  detail      String
  metaJson    String?
}
